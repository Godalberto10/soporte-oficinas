{
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "ask": [
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv run python:*)",
      "Bash(uv run office-support:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(type .env*)",
      "Bash(more .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(Get-Content .env*)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./docs/**)",
      "Write(./docs/**)",
      "Edit(./data/**)",
      "Write(./data/**)",
      "Bash(git push:*)",
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(rmdir:*)",
      "Bash(Remove-Item:*)",
      "Bash(curl:*)",
      "WebFetch"
    ]
  }
}
